# ===========================================
# PHG CONNECT - ENVIRONMENT VARIABLES
# ===========================================
# SECURITY NOTICE: This file contains sensitive configuration.
# Never commit actual keys or secrets to version control.
# Copy this file to .env.local and fill in your actual values.

# ===========================================
# SUPABASE CONFIGURATION (REQUIRED)
# ===========================================
# Get these from your Supabase project dashboard
# Project Settings > API > Project URL & anon public key
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# ===========================================
# APPLICATION CONFIGURATION
# ===========================================
VITE_APP_NAME=PHG Connect
VITE_APP_DESCRIPTION=PHG intranet and app platform
VITE_APP_URL=https://phg-connect.com
VITE_CERTIFICATE_VERIFY_URL=verify.phg-connect.com

# ===========================================
# DEVELOPMENT CONFIGURATION
# ===========================================
# Set to 'true' for development mode only
VITE_DEV_MODE=false
VITE_API_BASE_URL=http://localhost:5173/api
VITE_MOCK_AUTH=false

# ===========================================
# SECURITY & FEATURE FLAGS
# ===========================================
# Enable analytics and error reporting in production
VITE_ENABLE_ANALYTICS=false
VITE_ENABLE_ERROR_REPORTING=false
VITE_SENTRY_DSN=https://examplePublicKey@o0.ingest.sentry.io/0
VITE_SENTRY_ENV=production
VITE_RELEASE=local-build

# Sentry sourcemap upload (server-side build env only)
# These should be set in your CI/Vercel environment variables
# SENTRY_AUTH_TOKEN=your_sentry_auth_token
# SENTRY_ORG=your_sentry_org
# SENTRY_PROJECT=your_sentry_project

# ===========================================
# EDGE FUNCTION EMAIL CONFIG (SERVER SIDE)
# ===========================================
# RESEND_API_KEY=your_resend_api_key_here
# APP_BASE_URL=https://phg-connect.com
# EMAIL_FROM_ADDRESS=notifications@phg-connect.com
# EMAIL_FROM_NAME=PHG Connect

# ===========================================
# PRODUCTION SECURITY SETTINGS
# ===========================================
# Add these for production deployment
# VITE_ALLOWED_ORIGINS=https://phg-connect.com,https://www.phg-connect.com
# VITE_RATE_LIMIT_MAX=100
# VITE_RATE_LIMIT_WINDOW=900000

# ===========================================
# DEVELOPMENT ONLY
# ===========================================
# These should only be used in development
# VITE_DEV_SUPABASE_URL=https://dev-project.supabase.co
# VITE_DEV_SUPABASE_ANON_KEY=dev-key-here
