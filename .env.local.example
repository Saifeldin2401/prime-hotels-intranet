# ===========================================
# LOCAL DEVELOPMENT ENVIRONMENT (COPY TO .env.local)
# ===========================================
# SECURITY NOTICE:
# - Copy this file to .env.local and fill in real values
# - .env.local is gitignored and never committed
# - Never share your .env.local file

# Supabase Configuration (REQUIRED)
# Get these from: Supabase Dashboard > Project Settings > API
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=sb_publishable_your_anon_key_here

# Application Configuration
VITE_APP_NAME=PHG Connect
VITE_APP_DESCRIPTION=PHG intranet and app platform
VITE_APP_URL=http://localhost:5173
VITE_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000
VITE_CERTIFICATE_VERIFY_URL=verify.phg-connect.com

# Development Configuration
VITE_DEV_MODE=true
VITE_API_BASE_URL=http://localhost:5173/api
VITE_MOCK_AUTH=false

# Feature Flags
VITE_ENABLE_ANALYTICS=false
VITE_ENABLE_ERROR_REPORTING=false
VITE_SENTRY_DSN=https://examplePublicKey@o0.ingest.sentry.io/0

# Server-side API Keys (for Edge Functions only - NOT exposed to browser)
# These are used in Supabase Edge Functions, not in the Vite app
# SERPER_API_KEY=your_serper_api_key_here
# RESEND_API_KEY=your_resend_api_key_here
# SCRAPER_API_KEY=your_scraper_api_key_here
