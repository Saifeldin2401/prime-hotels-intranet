# ===========================================
# DEVELOPMENT ENVIRONMENT VARIABLES (PHG CONNECT)
# ===========================================
# SECURITY NOTICE:
# - Keep real values in untracked local files only.
# - This tracked file must stay sanitized.

# Supabase Configuration (REQUIRED)
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key_here

# Application Configuration
VITE_APP_NAME=PHG Connect
VITE_APP_DESCRIPTION=PHG intranet and app platform
VITE_APP_URL=http://localhost:5173
VITE_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000
VITE_CERTIFICATE_VERIFY_URL=verify.phg-connect.com

# Development Configuration
VITE_DEV_MODE=true
VITE_API_BASE_URL=http://localhost:5173/api
VITE_MOCK_AUTH=false

# Feature Flags
VITE_ENABLE_ANALYTICS=false
VITE_ENABLE_ERROR_REPORTING=true
VITE_SENTRY_DSN=https://examplePublicKey@o0.ingest.sentry.io/0
