{
  "name": "prime-hotels",
  "private": true,
  "version": "1.0.0",
  "description": "PHG Connect Intranet Platform - A comprehensive multi-property hotel intranet system with bilingual support (English/Arabic)",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "typecheck": "tsc -p tsconfig.app.json --noEmit",
    "verify": "npm run lint && npm run typecheck && npm run test:run",
    "build": "npm run typecheck && vite build",
    "lint": "eslint .",
    "preview": "vite preview",
    "test": "vitest",
    "test:run": "vitest run",
    "test:ui": "vitest --ui",
    "test:coverage": "vitest run --coverage",
    "check:migrations": "node scripts/check-migrations.mjs",
    "db:migrate": "powershell -ExecutionPolicy Bypass -File scripts/supabase-cmd.ps1 -Command migration",
    "db:push": "powershell -ExecutionPolicy Bypass -File scripts/supabase-cmd.ps1 -Command db push",
    "db:status": "powershell -ExecutionPolicy Bypass -File scripts/supabase-cmd.ps1 -Command migration list",
    "audit:ci": "npm audit --omit=dev --audit-level=critical",
    "security:check": "node scripts/validate-env.js && npm audit",
    "security:env": "node scripts/validate-env.js",
    "start": "vite preview --host 0.0.0.0"
  },
